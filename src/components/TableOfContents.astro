---
import type { MarkdownHeading } from 'astro';
interface Props { headings: MarkdownHeading[] }
const headings = Astro.props.headings.filter(heading => heading.depth === 2 || heading.depth === 3);
const groups: { heading: MarkdownHeading; children: MarkdownHeading[] }[] = [];
for (const heading of headings) {
  const previous = groups.at(-1);
  if (heading.depth === 3 && previous?.heading.depth === 2) previous.children.push(heading);
  else groups.push({ heading, children: [] });
}
---
{headings.length >= 2 && ['desktop', 'mobile'].map(mode => {
  const Tag = mode === 'desktop' ? 'nav' : 'details';
  return (
    <Tag class={`toc-${mode}`} aria-label="Table of contents">
      {mode === 'mobile' ? <summary>目次</summary> : <p class="toc-title">目次</p>}
      <ol>
        {groups.map(({ heading, children }) => (
          <li>
            <a href={`#${heading.slug}`}>{heading.text}</a>
            {children.length > 0 && <ol>{children.map(child => <li><a href={`#${child.slug}`}>{child.text}</a></li>)}</ol>}
          </li>
        ))}
      </ol>
    </Tag>
  );
})}

<script>
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.toc-desktop a, .toc-mobile a')];
  const headings = [...document.querySelectorAll<HTMLElement>('.post-content h2, .post-content h3')];
  if (links.length) {
    let queued = false;
    let previous: string | undefined;
    function update() {
      queued = false;
      let active = '';
      for (const heading of headings) {
        if (heading.getBoundingClientRect().top > 96) break;
        active = heading.id;
      }
      // The final section may be too short for its heading to reach the activation line.
      if (window.scrollY > 0 && window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 1) {
        active = headings.at(-1)?.id ?? '';
      }
      if (active === previous) return;
      previous = active;
      for (const link of links) {
        if (link.getAttribute('href') === `#${active}`) link.setAttribute('aria-current', 'location');
        else link.removeAttribute('aria-current');
      }
    }
    function schedule() {
      if (queued) return;
      queued = true;
      requestAnimationFrame(update);
    }
    window.addEventListener('scroll', schedule, { passive: true });
    for (const event of ['resize', 'hashchange', 'load', 'pageshow']) window.addEventListener(event, schedule);
    schedule();
  }
</script>
