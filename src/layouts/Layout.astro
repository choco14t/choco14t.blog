---
import '../styles/style.scss';
import ThemeSelect from '../components/ThemeSelect.astro';
interface Props { title?: string }
const { title = 'blog.choco14t.net' } = Astro.props;
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script is:inline>
      try {
        const theme = localStorage.getItem('theme');
        if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
      } catch { /* CSS retains the system theme if storage is unavailable. */ }
    </script>
    <title>{title}</title>
    <link rel="icon" href="/icon.png" />
  </head>
  <body>
    <header class="header"><div class="header-inner"><a href="/" class="brand">blog.choco14t.net</a><ThemeSelect /></div></header>
    <div class="container"><main class="content"><slot /></main></div>
    <footer class="footer">
      <div class="footer-container"><div class="footer-inner"><address>&copy; choco All rights reserved.</address></div></div>
    </footer>
  </body>
</html>
