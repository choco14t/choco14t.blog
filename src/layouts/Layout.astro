---
import '../styles/style.scss';
import ThemeMenu from '../components/ThemeMenu.astro';
interface Props { title?: string; article?: boolean; social?: boolean }
const { title = 'blog.choco14t.net', article = false, social = true } = Astro.props;
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const imageUrl = new URL('/og/default.png', Astro.site).href;
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script is:inline>
      try {
        const theme = localStorage.getItem('theme');
        if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
      } catch { /* CSS retains the system theme if storage is unavailable. */ }
    </script>
    <title>{title}</title>
    {social && <>
      <meta property="og:title" content={title} />
      <meta property="og:type" content="website" />
      <meta property="og:url" content={pageUrl} />
      <meta property="og:image" content={imageUrl} />
      <meta property="og:image:width" content="1200" />
      <meta property="og:image:height" content="630" />
      <meta property="og:image:type" content="image/png" />
      <meta property="og:image:alt" content="blog.choco14t.net" />
      <meta name="twitter:card" content="summary_large_image" />
      <meta name="twitter:title" content={title} />
      <meta name="twitter:image" content={imageUrl} />
      <meta name="twitter:image:alt" content="blog.choco14t.net" />
    </>}
    <link rel="icon" href="/icon.png" />
  </head>
  <body>
    <header class="header"><div class="header-inner"><a href="/" class="brand">blog.choco14t.net</a><ThemeMenu /></div></header>
    <div class:list={["container", { "container-article": article }]}><main class="content"><slot /></main></div>
    <footer class="footer">
      <div class="footer-container"><div class="footer-inner"><address>&copy; choco All rights reserved.</address></div></div>
    </footer>
  </body>
</html>
