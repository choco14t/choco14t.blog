---
import '../styles/style.scss';
import ThemeMenu from '../components/ThemeMenu.astro';
interface Props { title?: string; article?: boolean }
const { title = 'blog.choco14t.net', article = false } = Astro.props;
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script is:inline>
      try {
        const theme = localStorage.getItem('theme');
        if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
      } catch { /* CSS retains the system theme if storage is unavailable. */ }
    </script>
    <title>{title}</title>
    <link rel="icon" href="/icon.png" />
  </head>
  <body>
    <header class="header"><div class="header-inner"><a href="/" class="brand">blog.choco14t.net</a><ThemeMenu /></div></header>
    <div class:list={["container", { "container-article": article }]}><main class="content"><slot /></main></div>
    <footer class="footer">
      <div class="footer-container"><div class="footer-inner"><address>&copy; choco All rights reserved.</address></div></div>
    </footer>
  </body>
</html>
